BASE_URL = http://localhost:3000
# Must be at least 16 characters. Generate one with e.g. `openssl rand -hex 32`
# Anyone who knows this value can forge session cookies (including admin).
SESSION_SECRET=CHANGE_ME

# Will invalidate every passkey if changed
WEBAUTHN_RP_ID = localhost
WEBAUTHN_RP_ORIGIN = http://localhost:5173

S3_ENDPOINT = http://localhost:9000
S3_ACCESS_KEY_ID = minioadmin
S3_SECRET_ACCESS_KEY = minioadmin
S3_REGION = eu-north-1
S3_BUCKET_MEDIA = media
S3_BUCKET_COVERS = media-covers